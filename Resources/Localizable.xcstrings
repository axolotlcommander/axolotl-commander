    "%lld item(s) were copied but not removed, because they contain a link to a folder or could not be checked completely.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky (%lld) byly zkopírovány, ale nebyly odstraněny, protože obsahují odkaz na složku nebo je nebylo možné zcela zkontrolovat."
          }
        }
      }
    },
    "%lld item(s) were not removed, because they contain a link to a folder, were skipped or did not arrive completely.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položek, které nebyly odstraněny, protože obsahují odkaz na složku, byly přeskočeny nebo nedorazily celé: %lld."
          }
        }
      }
    },
